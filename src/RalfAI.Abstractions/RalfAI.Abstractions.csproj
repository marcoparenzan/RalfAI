<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RalfAI.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>IAgentContext and the other extension points RalfAI contexts implement, extracted so other hosts (e.g. a notebook kernel) can build their own contexts without depending on RalfAI's CLI/agent machinery.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
  </ItemGroup>

</Project>
