{
    "AgentContext": "markdown",
    "Editor": "code.exe",
    "AIProvider": "foundry",
    "AzureAIFoundry": {
        "Endpoint": "<your-foundry-or-azure-openai-endpoint>",
        "ApiKey": "<your-api-key>",
        "ModelId": "<your-deployment-name>",
